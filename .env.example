# Copiar a .env y completar. Nunca commitear .env.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
MAX_SESSION_TOKENS=200000
ACCESS_KEY=
PORT=3000
# HOY=2026-09-03
MAX_DAILY_TOKENS=2000000
# TRUST_PROXY=1   # detrás de proxy (Render lo activa solo): usa x-forwarded-for para el rate limit

# LangGraph controla los pasos; LangChain solo invoca el proveedor.
MAX_STEPS=25
MAX_TOOL_CALLS=100
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=4096
# Trazas externas desactivadas en código hasta definir redacción y permisos.
LANGSMITH_TRACING=false
